# Copy to .env.local — Vite auto-loads it, and it's gitignored

# Where the Django backend is running
VITE_API_BASE=http://localhost:8000/api

# From Google Cloud Console -> OAuth 2.0 Client IDs (Web application).
# Must match the SAME client id the Django backend's GOOGLE_OAUTH_CLIENT_ID
# is set to, or Google Sign-In will fail token verification.
# Leave blank to hide the Google Sign-In button entirely.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
