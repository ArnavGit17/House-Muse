# Copy to .env and fill in real values — never commit .env itself

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=house_muse
DB_USER=house_muse_user
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# From Google Cloud Console → OAuth 2.0 Client IDs (Web application)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Where the ml/ Flask service is running
ML_SERVICE_URL=http://localhost:5000
